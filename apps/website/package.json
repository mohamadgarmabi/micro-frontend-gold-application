{
  "name": "@gold/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview --port 4300 --strictPort"
  },
  "nx": {
    "name": "website",
    "projectType": "application",
    "sourceRoot": "apps/website/src",
    "implicitDependencies": [
      "design-system",
      "shared-components",
      "apis"
    ],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "syncGenerators": [
          "@juristr/nx-tailwind-sync:source-directives"
        ],
        "dependsOn": [
          "shared-components:dev"
        ],
        "options": {
          "command": "vite --port 4300 --strictPort",
          "cwd": "apps/website"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "syncGenerators": [
          "@juristr/nx-tailwind-sync:source-directives"
        ],
        "dependsOn": [
          "shared-components:build"
        ],
        "options": {
          "command": "vite build",
          "cwd": "apps/website"
        }
      }
    }
  },
  "dependencies": {
    "@gold/apis": "workspace:*",
    "@gold/design-system": "workspace:*",
    "@gold/form": "workspace:*",
    "@gold/shared-components": "workspace:*",
    "@module-federation/runtime": "^2.9.0",
    "@tanstack/vue-query": "^5.103.1",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.22.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "oxc-transform-react": "^0.145.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0"
  }
}
