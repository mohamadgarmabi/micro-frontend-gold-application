{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "tailwindCSS.includeLanguages": {
    "javascript": "javascript",
    "javascriptreact": "javascript",
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "class:list"
  ],
  "tailwindCSS.classFunctions": ["cva", "cn", "clsx", "twJoin", "twMerge"],
  "tailwindCSS.experimental.configFile": {
    "apps/application-pwa/src/styles.css": "apps/application-pwa/**",
    "apps/website/src/styles.css": "apps/website/**",
    "apps/storybook/src/styles.css": "apps/storybook/**",
    "packages/design-system/src/styles.css": "packages/**"
  }
}
