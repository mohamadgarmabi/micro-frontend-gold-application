{
  "name": "@gold/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "stop": "for port in 4200 4300 4400 5100; do lsof -ti tcp:$port | xargs kill -9 2>/dev/null; done || true",
    "generate:components": "tsx scripts/generate-base-ui-components.ts",
    "check:no-js": "tsx scripts/check-no-js-source.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "predev:react": "pnpm stop",
    "predev:website": "pnpm stop",
    "predev:application-pwa": "pnpm stop",
    "dev:website": "nx dev website",
    "dev:application-pwa": "nx dev application-pwa",
    "dev:components": "nx dev shared-components",
    "build": "nx run-many -t build -p shared-components,website,application-pwa,form",
    "lint": "nx run-many -t lint --all --output-style=static",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p apps/application-pwa/tsconfig.json && tsc --noEmit -p packages/shared-components/tsconfig.json && tsc --noEmit -p packages/form/tsconfig.json && pnpm typecheck:scripts",
    "test": "nx run-many -t test -p form,apis,shared-components -- --run",
    "test:watch": "nx run-many -t test -p form,apis,shared-components",
    "preview:components": "nx preview shared-components",
    "preview:form": "nx preview form",
    "preview:application-pwa": "nx preview application-pwa",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@module-federation/runtime": "^2.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@juristr/nx-tailwind-sync": "^0.0.9",
    "@module-federation/vite": "^1.22.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@svgr/webpack": "^8.1.0",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.16.2",
    "@swc/helpers": "~0.5.23",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "~4.1.11",
    "@vitest/ui": "~4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "nx": "23.2.1",
    "oxc-transform-react": "^0.145.0",
    "prettier": "~3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-refresh": "^0.19.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "~4.1.11",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.6"
  }
