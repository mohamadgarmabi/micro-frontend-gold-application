        }
      }
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "~5.9.2"
  }
}
